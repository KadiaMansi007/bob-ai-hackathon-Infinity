# =============================================================================
# Infinity Threat Intelligence Fusion & Prioritisation Platform
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is already in .gitignore.
# =============================================================================

# --- IBM Bob AI (required for the AI review layer) ---------------------------
# Your IBM Bob API key. Without this, the deterministic pipeline runs fully
# but the AI review layer (classify_threat, score_explanation, BLUF) is disabled.
BOB_API_KEY=your_bob_api_key_here

# URL of the Bob MCP server (change if running in Docker Compose)
BOB_MCP_URL=http://localhost:8001

# --- Database ----------------------------------------------------------------
# SQLAlchemy database URL. Defaults to a local SQLite file.
# To use PostgreSQL: postgresql://user:password@localhost:5432/infinity_threat
DATABASE_URL=sqlite:///./infinity_threat.db

# --- Backend API -------------------------------------------------------------
# API key required in the X-API-Key header for write endpoints.
# Change this in any environment other than local development.
API_KEY=dev-key-infinity

# Port the FastAPI backend binds to.
APP_PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed CORS origins.
# Add your frontend origin if deploying to a different host.
CORS_ORIGINS=http://localhost:5173

# --- Feed Generator ----------------------------------------------------------
# Optional integer seed for deterministic synthetic feed generation.
# Set to a fixed number (e.g. 42) to reproduce the same alert set on every run.
# Leave empty for random data.
FEED_SEED=

# --- Application Environment -------------------------------------------------
APP_ENV=development
